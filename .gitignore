# Dataset files (auto-downloaded)
data/*
!data/.gitkeep

# Python environments
.venv/
venv/
env/
koto/

# Byte-compiled / optimised
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Model checkpoints (large binary files)
checkpoints/

# HuggingFace / torch caches
.cache/
*.safetensors
*.pt

# Large trained model weights — regenerate with train.py
models/classifier/
models/faiss_index.bin
!models/.gitkeep

# Generated artifacts — regenerate with evaluate.py
artifacts/*
!artifacts/.gitkeep

# MLflow database binary (auto-regenerated, too large for git)
mlflow.db

# Jupyter
.ipynb_checkpoints/

# OS artefacts
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp

# Logs
*.log

# Dependency directories
node_modules/

# !! DO NOT IGNORE mlruns !!
# mlruns/ is intentionally tracked in Git (required for evaluation)
